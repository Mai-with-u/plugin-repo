{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_id",
    "repository_url",
    "version",
    "tag",
    "commit",
    "reviewed",
    "decision",
    "summary",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "plugin_id": {
      "type": "string"
    },
    "repository_url": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "reviewed": {
      "type": "boolean"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "manual_review"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
