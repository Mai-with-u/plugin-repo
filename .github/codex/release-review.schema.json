{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "repository_url", "releases"],
  "properties": {
    "schema_version": { "const": 1 },
    "plugin_id": { "type": "string" },
    "repository_url": { "type": "string" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "tag", "commit", "reviewed", "decision", "summary", "risks"],
        "properties": {
          "version": { "type": "string" },
          "tag": { "type": "string" },
          "commit": { "type": "string" },
          "reviewed": { "type": "boolean" },
          "decision": { "enum": ["pass", "manual_review"] },
          "summary": { "type": "string", "minLength": 1 },
          "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
